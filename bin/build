#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"
qmake6 "$ROOT/cursora.pro"
make -j"$(nproc)"
"$ROOT/bin/prepare-themes"
themes="$ROOT/build/themes"
QT_QPA_PLATFORM=offscreen ./cursora monochrome-themes "$themes"
for tone in Black White; do
    bibata="$themes/Cursora-Bibata-Original-$tone"
    terminal="$themes/Cursora-Omarchy-Terminal"
    set --
    if [ "$tone" = White ]; then
        terminal="$terminal-Light"
        set -- --light
    fi
    QT_QPA_PLATFORM=offscreen ./cursora build-omarchy-pack "$terminal" "$themes/bibata-original-pointer.svg" "$@"
    cp "$ROOT/LICENSE" "$terminal/COPYING"
    cp "$bibata/COPYING" "$terminal/COPYING-Bibata"
    cat > "$terminal/NOTICE" <<'EOF'
The arrows in left_ptr, progress, copy, alias, help and context-menu are adapted from
Bibata Original 2.0.7 by ful1e5 and contributors. Cursora adjusts the scale, palette
and outline weight, cuts the main pointer's corners, and adds terminal-style badges.
These cursors are distributed under GPL-3.0-only. See COPYING-Bibata and https://github.com/ful1e5/Bibata_Cursor.
The pinned Bibata release and source archives are shipped in /usr/share/cursora/sources.
The other Omarchy Terminal cursors use the MIT license. See COPYING and omarchycursor.cpp.
EOF
done
