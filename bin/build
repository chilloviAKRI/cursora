#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"
qmake6 "$ROOT/cursora.pro"
make -j"$(nproc)"
"$ROOT/bin/prepare-themes"
QT_QPA_PLATFORM=offscreen ./cursora monochrome-themes "$ROOT/build/themes"
QT_QPA_PLATFORM=offscreen ./cursora build-omarchy-pack "$ROOT/build/themes/Cursora-Omarchy-Terminal"
cp "$ROOT/LICENSE" "$ROOT/build/themes/Cursora-Omarchy-Terminal/COPYING"
