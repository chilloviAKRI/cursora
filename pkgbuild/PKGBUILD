pkgname=cursora
pkgver=0.2.0
pkgrel=1
pkgdesc='Monochrome cursor pack picker for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT' 'GPL-3.0-only' 'CC-BY-SA-4.0')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'libxcursor' 'glib2' 'hyprland' 'dbus' 'adwaita-cursors')
makedepends=('gcc' 'make' 'python')
source=()
sha256sums=()
build() {
  cd "$startdir/.."
  ./bin/build
}
package() {
  cd "$startdir/.."
  install -Dm755 build/cursora "$pkgdir/usr/bin/cursora"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 pkgbuild/cursora.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cursora.svg"
  install -Dm644 pkgbuild/cursora.desktop "$pkgdir/usr/share/applications/cursora.desktop"
  install -d "$pkgdir/usr/share/icons"
  cp -rP build/themes/Cursora-* "$pkgdir/usr/share/icons/"
  install -d "$pkgdir/usr/share/cursora/sources"
  cp vendor/*-source.tar.gz vendor/sources.json "$pkgdir/usr/share/cursora/sources/"
  cp src/cursorimages.cpp bin/prepare-themes src/packs.json "$pkgdir/usr/share/cursora/sources/"
}
